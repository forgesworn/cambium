<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Cambium.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/boardLabelValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Cambium.Label"
        tools:text="Desk Heartwood" />

    <TextView
        android:id="@+id/boardDetailValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Cambium.Detail"
        tools:text="Board record 3291 · 2 relays" />

    <TextView
        android:id="@+id/boardStatusValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.Cambium.Body"
        android:textColor="@color/warning"
        android:visibility="gone"
        tools:text="Asking to be unlocked" />

    <Button
        android:id="@+id/boardUnlockButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/unlock_action"
        android:visibility="gone" />

    <Button
        android:id="@+id/boardForgetButton"
        style="@style/Widget.Cambium.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/unlock_forget_button"
        android:textColor="@color/danger" />
</LinearLayout>
