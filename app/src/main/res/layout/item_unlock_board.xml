<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/boardLabelValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/on_background"
            tools:text="desk" />

        <TextView
            android:id="@+id/boardDetailValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/on_background_muted"
            android:textSize="11sp"
            tools:text="Board record 3291 · 2 relays" />

        <TextView
            android:id="@+id/boardStatusValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/warning"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Asking to be unlocked"
            tools:visibility="visible" />
    </LinearLayout>

    <Button
        android:id="@+id/boardUnlockButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/unlock_action"
        android:visibility="gone"
        tools:visibility="visible" />

    <Button
        android:id="@+id/boardForgetButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/unlock_forget_button"
        android:textColor="@color/danger" />
</LinearLayout>
