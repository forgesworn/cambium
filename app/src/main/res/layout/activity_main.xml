<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/status_background"
                android:importantForAccessibility="no"
                android:padding="6dp"
                android:src="@drawable/ic_cambium" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Cambium.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_tagline"
                    android:textAppearance="@style/TextAppearance.Cambium.Detail" />
            </LinearLayout>
        </LinearLayout>

        <!-- All pairing and permission content stays behind the existing app-lock gate. -->
        <LinearLayout
            android:id="@+id/lockedSection"
            style="@style/Widget.Cambium.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/app_lock_locked_title"
                android:textAppearance="@style/TextAppearance.Cambium.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_lock_locked_body"
                android:textAppearance="@style/TextAppearance.Cambium.Body" />

            <Button
                android:id="@+id/unlockButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_lock_unlock_button" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/contentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/statusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:background="@drawable/status_background"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textAppearance="@style/TextAppearance.Cambium.Detail"
                android:textColor="@color/accent"
                tools:text="Not paired" />

            <!-- These three sections keep their original shared visibility rule. -->
            <LinearLayout
                android:id="@+id/pairedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    style="@style/Widget.Cambium.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/paired_signers_label"
                        android:textAppearance="@style/TextAppearance.Cambium.Section" />

                    <LinearLayout
                        android:id="@+id/pairingsListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/unpairAllButton"
                        style="@style/Widget.Cambium.Button.Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/unpair_all_button"
                        android:textColor="@color/danger" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.Cambium.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/keep_alive_toggle_title"
                                android:textAppearance="@style/TextAppearance.Cambium.Label" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/keep_alive_toggle_body"
                                android:textAppearance="@style/TextAppearance.Cambium.Detail" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/keepAliveToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/keep_alive_toggle_title"
                            android:minHeight="48dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/notificationHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/notification_permission_denied"
                        android:textAppearance="@style/TextAppearance.Cambium.Detail"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.Cambium.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/connected_apps_label"
                        android:textAppearance="@style/TextAppearance.Cambium.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/connected_apps_body"
                        android:textAppearance="@style/TextAppearance.Cambium.Body" />

                    <TextView
                        android:id="@+id/connectedAppsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:background="@drawable/row_background"
                        android:padding="16dp"
                        android:text="@string/connected_apps_empty"
                        android:textAppearance="@style/TextAppearance.Cambium.Body"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/connectedAppsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/activityLogButton"
                        style="@style/Widget.Cambium.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/activity_log_button" />
                </LinearLayout>
            </LinearLayout>

            <!-- Phone unlock is independent of signer pairing, including after Unpair all. -->
            <LinearLayout
                android:id="@+id/unlockSection"
                style="@style/Widget.Cambium.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/unlock_section_label"
                    android:textAppearance="@style/TextAppearance.Cambium.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/unlock_section_body"
                    android:textAppearance="@style/TextAppearance.Cambium.Body" />

                <LinearLayout
                    android:id="@+id/unlockBoardsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/unlockBatteryButton"
                    style="@style/Widget.Cambium.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_button"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Always available: adding another signer uses exactly the same pairing flow. -->
            <LinearLayout
                android:id="@+id/pairingSection"
                style="@style/Widget.Cambium.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/pair_section_title"
                    android:textAppearance="@style/TextAppearance.Cambium.Section" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pair_hint"
                    android:textAppearance="@style/TextAppearance.Cambium.Body" />

                <Button
                    android:id="@+id/scanButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/scan_qr_button"
                    app:icon="@drawable/ic_qr_scan"
                    app:iconGravity="textStart" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="12dp"
                    android:gravity="center"
                    android:text="@string/pair_paste_alternative"
                    android:textAppearance="@style/TextAppearance.Cambium.Detail" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Cambium.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/pair_link_label"
                    android:importantForAutofill="noExcludeDescendants"
                    app:placeholderText="@string/pair_input_hint"
                    app:placeholderTextColor="@color/on_background_muted">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bunkerInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:inputType="textUri"
                        android:maxLines="3"
                        android:minHeight="56dp"
                        android:textSize="14sp"
                        app:fontFamily="monospace" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Cambium.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/pair_label_hint"
                    android:importantForAutofill="noExcludeDescendants">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/labelInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:minHeight="56dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/pairingError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.Cambium.Body"
                    android:textColor="@color/danger"
                    android:visibility="gone"
                    tools:text="Signer public key must be 64 hex characters" />

                <TextView
                    android:id="@+id/cameraHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/camera_permission_denied"
                    android:textAppearance="@style/TextAppearance.Cambium.Body"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/pairButton"
                    style="@style/Widget.Cambium.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pair_button" />

                <LinearLayout
                    android:id="@+id/pairingProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="12dp"
                        android:indeterminateTint="@color/accent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/pairing_in_progress"
                        android:textAppearance="@style/TextAppearance.Cambium.Body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Cambium.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/app_lock_toggle_title"
                            android:textAppearance="@style/TextAppearance.Cambium.Label" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/app_lock_toggle_body"
                            android:textAppearance="@style/TextAppearance.Cambium.Detail" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/appLockToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/app_lock_toggle_title"
                        android:minHeight="48dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/appLockUnavailableHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/app_lock_unavailable_hint"
                    android:textAppearance="@style/TextAppearance.Cambium.Detail"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
