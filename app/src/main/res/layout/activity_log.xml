<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <Button
            android:id="@+id/backButton"
            style="@style/Widget.Cambium.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/app_name"
            android:contentDescription="@string/back_button_description"
            app:icon="@drawable/ic_arrow_back" />

        <LinearLayout
            android:id="@+id/lockedSection"
            style="@style/Widget.Cambium.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/app_lock_locked_title"
                android:textAppearance="@style/TextAppearance.Cambium.Section" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/app_lock_locked_body"
                android:textAppearance="@style/TextAppearance.Cambium.Body" />

            <Button
                android:id="@+id/unlockButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_lock_unlock_button" />
        </LinearLayout>

        <!-- Content remains wholly behind ActivityLogActivity's existing app-lock check.
             The whole page scrolls, including its controls, for larger system text. -->
        <LinearLayout
            android:id="@+id/contentSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/activity_log_title"
                android:textAppearance="@style/TextAppearance.Cambium.Title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:text="@string/activity_log_body"
                android:textAppearance="@style/TextAppearance.Cambium.Body" />

            <LinearLayout
                style="@style/Widget.Cambium.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:text="@string/activity_log_toggle_title"
                        android:textAppearance="@style/TextAppearance.Cambium.Label" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/logToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/activity_log_toggle_title"
                        android:minHeight="48dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/clearButton"
                    style="@style/Widget.Cambium.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/activity_log_clear_button"
                    android:textColor="@color/danger" />
            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Cambium.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_filter_app"
                    android:labelFor="@id/appFilter"
                    android:textAppearance="@style/TextAppearance.Cambium.Label" />
                <Spinner
                    android:id="@+id/appFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_filter_identity"
                    android:labelFor="@id/identityFilter"
                    android:textAppearance="@style/TextAppearance.Cambium.Label" />
                <Spinner
                    android:id="@+id/identityFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_filter_outcome"
                    android:labelFor="@id/outcomeFilter"
                    android:textAppearance="@style/TextAppearance.Cambium.Label" />
                <Spinner
                    android:id="@+id/outcomeFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/diagnostics_share_body"
                    android:textAppearance="@style/TextAppearance.Cambium.Detail" />
                <Button
                    android:id="@+id/shareReportButton"
                    style="@style/Widget.Cambium.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/diagnostics_review_report" />
            </LinearLayout>

            <TextView
                android:id="@+id/logEmpty"
                style="@style/Widget.Cambium.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/activity_log_empty"
                android:textAppearance="@style/TextAppearance.Cambium.Body"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/logContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
