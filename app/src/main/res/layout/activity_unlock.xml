<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/unlockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/on_background"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Unlock desk?" />

        <TextView
            android:id="@+id/unlockContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/on_background"
            tools:text="power-on, devolo-753, restart #212" />

        <TextView
            android:id="@+id/unlockDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/on_background_muted"
            android:textSize="12sp"
            tools:text="firmware 0.18.0-beta.17, access point aa:bb:cc:dd:ee:ff, asked 20 s ago" />

        <TextView
            android:id="@+id/unlockLastHeard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textColor="@color/on_background_muted"
            android:textSize="12sp"
            tools:text="It last answered Cambium 12 minutes ago." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="@string/unlock_warning"
            android:textColor="@color/warning" />

        <TextView
            android:id="@+id/unlockStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textColor="@color/on_background"
            android:visibility="gone"
            tools:text="Sent. The board shows Unlocked by on its screen."
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/unlockConfirmButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:fontFamily="monospace"
                android:text="@string/unlock_action" />

            <Button
                android:id="@+id/unlockCloseButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/unlock_not_now" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
