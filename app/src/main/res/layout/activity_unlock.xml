<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            style="@style/Widget.Cambium.Card">
            <TextView
                android:id="@+id/unlockTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/on_background"
                tools:text="Unlock desk?"
                android:textAppearance="@style/TextAppearance.Cambium.Title"
                android:accessibilityHeading="true" />
            <TextView
                android:id="@+id/unlockContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/on_background"
                tools:text="power-on, devolo-753, restart #212"
                android:textAppearance="@style/TextAppearance.Cambium.Body" />
            <TextView
                android:id="@+id/unlockDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_background_muted"
                tools:text="firmware 0.18.0-beta.17, access point aa:bb:cc:dd:ee:ff, asked 20 s ago"
                android:textAppearance="@style/TextAppearance.Cambium.Code" />
            <TextView
                android:id="@+id/unlockLastHeard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/on_background_muted"
                tools:text="It last answered Cambium 12 minutes ago."
                android:textAppearance="@style/TextAppearance.Cambium.Code" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/unlock_warning"
                android:textColor="@color/warning"
                android:textAppearance="@style/TextAppearance.Cambium.Body"
                android:background="@drawable/row_background"
                android:padding="16dp" />
            <TextView
                android:id="@+id/unlockStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/on_background"
                android:visibility="gone"
                tools:text="Sent. The board shows Unlocked by on its screen."
                tools:visibility="visible"
                android:textAppearance="@style/TextAppearance.Cambium.Body"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/row_background"
                android:padding="16dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">
                <Button
                    android:id="@+id/unlockConfirmButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/unlock_action" />
                <Button
                    android:id="@+id/unlockCloseButton"
                    style="@style/Widget.Cambium.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/unlock_not_now" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
