<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Cambium.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/pairingLabelValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Cambium.Label"
        tools:text="Living room Heartwood" />

    <TextView
        android:id="@+id/pairingNpubValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:breakStrategy="simple"
        android:textAppearance="@style/TextAppearance.Cambium.Code"
        android:textIsSelectable="true"
        tools:text="npub1exampleexampleexampleexampleexampleexampleexampleexamplex" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/relays_label"
        android:textAppearance="@style/TextAppearance.Cambium.Detail" />

    <TextView
        android:id="@+id/pairingRelaysValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:breakStrategy="simple"
        android:textAppearance="@style/TextAppearance.Cambium.Code"
        tools:text="wss://relay.example" />

    <Button
        android:id="@+id/pairingUnlockButton"
        style="@style/Widget.Cambium.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/unlock_setup_button" />

    <Button
        android:id="@+id/pairingUnpairButton"
        style="@style/Widget.Cambium.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/unpair_button"
        android:textColor="@color/danger" />
</LinearLayout>
