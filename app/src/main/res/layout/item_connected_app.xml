<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Cambium.Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/appPackageValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Cambium.Label"
        tools:text="Amethyst" />

    <TextView
        android:id="@+id/appStateValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/status_background"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:textAppearance="@style/TextAppearance.Cambium.Detail"
        android:textColor="@color/accent"
        tools:text="Approved" />

    <TextView
        android:id="@+id/appIdentityValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Cambium.Detail"
        android:visibility="gone"
        tools:text="Living room Heartwood"
        tools:visibility="visible" />

    <Button
        android:id="@+id/editAppButton"
        style="@style/Widget.Cambium.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/edit_button" />

    <TextView
        android:id="@+id/appPermissionDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Cambium.Detail" />

    <Button
        android:id="@+id/forgetButton"
        style="@style/Widget.Cambium.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="@string/connected_apps_forget" />
</LinearLayout>
