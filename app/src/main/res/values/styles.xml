<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Cambium.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="TextAppearance.Cambium.Section" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="TextAppearance.Cambium.Label" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.Cambium.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_background_muted</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.Cambium.Detail" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/on_background_muted</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="TextAppearance.Cambium.Code" parent="TextAppearance.Cambium.Detail">
        <item name="fontFamily">monospace</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="Widget.Cambium.Card" parent="">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:padding">20dp</item>
    </style>
    <style name="Widget.Cambium.Row" parent="">
        <item name="android:background">@drawable/row_background</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="Widget.Cambium.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Cambium.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Cambium.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Cambium.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>
